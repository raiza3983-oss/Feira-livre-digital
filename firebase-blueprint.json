{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores details about a user including their role and associated shop.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string" },
        "loginType": { "type": "string" },
        "shopId": { "type": "string" },
        "shopType": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "isApprovedAdmin": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Shop": {
      "title": "Shop",
      "description": "Details about a physical or virtual shop.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "ownerUid": { "type": "string" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "photoURL": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "whatsapp": { "type": "string" },
        "isOpen": { "type": "boolean" },
        "rating": { "type": "number" },
        "openingTime": { "type": "string" },
        "closingTime": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerUid"]
    },
    "Product": {
      "title": "Product",
      "description": "A product sold by a shop.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "cost": { "type": "number" },
        "stock": { "type": "number" },
        "unit": { "type": "string" },
        "weightPerUnit": { "type": "number" },
        "category": { "type": "string" },
        "photoURL": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "stock"]
    },
    "Order": {
      "title": "Order",
      "description": "An order placed by a customer to a shop.",
      "type": "object",
      "properties": {
        "buyerUid": { "type": "string" },
        "buyerName": { "type": "string" },
        "buyerPhone": { "type": "string" },
        "shopId": { "type": "string" },
        "shopName": { "type": "string" },
        "shopOwnerUid": { "type": "string" },
        "status": { "type": "string" },
        "totalValue": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "deliveryType": { "type": "string" },
        "items": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["buyerUid", "shopId", "status", "totalValue", "items"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "A message in a chat between users.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "text": { "type": "string" },
        "orderId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "receiverId", "text"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual user profiles."
    },
    "/shops/{shopId}": {
      "schema": "Shop",
      "description": "Details for each shop."
    },
    "/shops/{shopId}/products/{productId}": {
      "schema": "Product",
      "description": "Products within a shop."
    },
    "/shops/{shopId}/sales/{saleId}": {
      "schema": "Order",
      "description": "Manual sales recorded by the shop owner."
    },
    "/shops/{shopId}/disbursements/{disId}": {
      "schema": "object",
      "description": "Financial disbursements records."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders."
    },
    "/chatMessages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Direct chat messages between users."
    },
    "/appConfig/{id}": {
      "schema": "object",
      "description": "Global application configuration."
    }
  }
}
