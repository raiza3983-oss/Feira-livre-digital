rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "raiza3983@gmail.com" || 
        request.auth.token.email == "rz7beats@gmail.com" || 
        request.auth.token.email == "raizapauladossantos@gmail.com" || 
        request.auth.token.email == "raizapaulapaula83@gmail.com"
      ) && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- App Config (Public Read) ---
    
    match /appConfig/{id} {
      allow read: if true;
      allow write: if isAdmin(); 
    }

    // --- Notifications (Public Read) ---
    
    match /notifications/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- User Profiles ---
    
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'role']) 
          && data.uid == userId
          && data.uid is string
          && data.email is string
          && data.role is string;
      }
      
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) 
        || isAdmin();
    }

    // --- Shops & Products ---
    
    match /shops/{shopId} {
      allow read: if true; 
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isOwner(existing().ownerUid);

      match /products/{productId} {
        allow read: if true;
        allow write: if isAdmin() || isOwner(get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid);
      }

      match /sales/{saleId} {
        allow read, write: if isAdmin() || isOwner(get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid);
      }
      
      match /disbursements/{disId} {
        allow read, write: if isAdmin() || isOwner(get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid);
      }
    }

    // --- Orders ---
    
    match /orders/{orderId} {
      allow read: if isSignedIn() && (isAdmin() || isOwner(existing().buyerUid) || isOwner(existing().shopOwnerUid));
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isAdmin() || isOwner(existing().buyerUid) || isOwner(existing().shopOwnerUid));
    }

    // --- Chat Messages ---
    
    match /chatMessages/{messageId} {
      allow read: if isSignedIn() && (
        isOwner(existing().senderUid) || isOwner(existing().receiverUid) ||
        isOwner(existing().senderId) || isOwner(existing().receiverId) ||
        isAdmin()
      );
      allow create: if isSignedIn();
    }

    // --- Others ---
    
    match /contactMessages/{id} {
      allow read, delete: if isAdmin();
      allow create: if true;
    }

    match /quickMessages/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /jobOpenings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /jobApplications/{id} {
      allow read: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /healthcheck/{id} {
      allow read, write: if true;
    }

    match /deletedUsers/{id} {
      allow read, write: if isAdmin();
    }

    // --- Collection Groups ---
    
    match /{path=**}/products/{productId} {
      allow read: if true;
    }

    match /{path=**}/sales/{saleId} {
      allow read: if isAdmin() || (isSignedIn() && (isOwner(resource.data.shopOwnerUid) || isOwner(resource.data.buyerUid)));
    }

    match /{path=**}/disbursements/{disId} {
      allow read: if isAdmin() || (isSignedIn() && isOwner(resource.data.shopOwnerUid));
    }
  }
}
