rules_version = '2';

// Regulamento de Segurança do Google Cloud Firestore - Feira Livre
// Arquivo preparado para versionamento no GitHub, facilitando o entendimento de segurança e governança de acessos.
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // 0. BLOQUEIO GLOBAL PADRÃO (SAFETY NET)
    // Proteção preventiva contra acessos a coleções não mapeadas de forma explícita.
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // 1. FUNÇÕES AUXILIARES DE SEGURANÇA (HELPERS)
    // Funções modulares usadas para validação de identidade e privilégios.
    // ==========================================
    
    // Verifica se o usuário realizou login no sistema
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Verifica se o usuário autenticado é o próprio dono do registro
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Identifica se o usuário atual é um dos Administradores Principais (Super Admins) listados.
    // O e-mail também deve estar obrigatoriamente verificado para evitar spoofing de e-mail.
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "raiza3983@gmail.com" || 
        request.auth.token.email == "rz7beats@gmail.com" || 
        request.auth.token.email == "raizapauladossantos@gmail.com" || 
        request.auth.token.email == "raizapaulapaula83@gmail.com"
      ) && request.auth.token.email_verified == true;
    }

    // Define privilégios de Administrador. Pode ser um Super Admin ou ter seu UID registrado na coleção `/admins/`
    function isAdmin() {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    
    // Atalho para extrair os dados sendo gravados na requisição atual
    function incoming() {
      return request.resource.data;
    }

    // Atalho para extrair os dados existentes no documento atualmente salvo no banco
    function existing() {
      return resource.data;
    }

    // ==========================================
    // 2. REGRAS DE ACESSO POR COLEÇÃO
    // ==========================================

    // --- Configurações do Aplicativo (/appConfig) ---
    // Definições globais de sistema (layouts, banners, etc.).
    match /appConfig/{id} {
      allow read: if true; // Qualquer visitante pode ler as configurações de design
      allow write: if isAdmin(); // Apenas administradores podem atualizar as configurações
    }

    // --- Canal de Notificações (/notifications) ---
    // Avisos e boletins informativos do portal.
    match /notifications/{id} {
      allow read: if true; // Notificações são públicas para todos os usuários e visitantes
      allow create, delete: if isAdmin(); // Apenas editores/admins criam ou excluem comunicados
    }

    // --- Perfis de Usuário (/users) ---
    // Registro de cadastros de clientes e feirantes do ecossistema.
    match /users/{userId} {
      // Regra estrutural de validação para novos cadastros
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'role']) 
          && data.uid == userId
          && data.uid is string
          && data.email is string
          && data.role is string;
      }
      
      allow read: if isSignedIn(); // Usuários logados podem ler perfis (por exemplo, em listagens ou buscas)
      allow create: if isOwner(userId) && isValidUser(incoming()); // Criação exige correspondência de UID e campos válidos
      allow update: if isOwner(userId) || isAdmin(); // Atualização pelo próprio usuário ou por um administrador
    }

    // --- Lojas e Feirantes (/shops) ---
    // Cadastro de estabelecimentos (feirantes, quitandas, etc.).
    match /shops/{shopId} {
      allow read: if true; // Visitantes podem visualizar os detalhes da loja
      allow create: if isSignedIn(); // Qualquer usuário logado pode registrar sua própria loja comercial
      allow update, delete: if isAdmin() || isOwner(existing().ownerUid); // Apenas o dono da loja ou administrador pode editar/excluir

      // --- Produtos da Loja (/shops/{shopId}/products) ---
      // Itens expostos à venda em cada estabelecimento.
      match /products/{productId} {
        allow read: if true; // Itens à venda são públicos para livre navegação
        allow write: if isAdmin() || isOwner(get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid); // Somente o dono do estabelecimento ou admin pode adicionar/editar/remover produtos
      }

      // --- Vendas e Histórico de Vendas (/shops/{shopId}/sales) ---
      // Registros financeiros gerados pelo lojista.
      match /sales/{saleId} {
        allow read, write: if isAdmin() || isOwner(get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid); // Restrito ao dono da loja e administradores por sigilo empresarial
      }
      
      // --- Disbursementos e Repasses (/shops/{shopId}/disbursements) ---
      // Extrato de comissões e repasses de saldo.
      match /disbursements/{disId} {
        allow read, write: if isAdmin() || isOwner(get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid); // Restrito ao dono e administradores
      }
    }

    // --- Pedidos de Compra (/orders) ---
    // Fluxo de pedidos de ponta a ponta ligando compradores e vendedores.
    match /orders/{orderId} {
      // Permite ler se for Admin, o comprador real do pedido, ou o dono da loja vendendo os itens
      allow read: if isSignedIn() && (isAdmin() || isOwner(existing().buyerUid) || isOwner(existing().shopOwnerUid));
      allow create: if isSignedIn(); // Qualquer cliente autenticado pode iniciar um novo pedido
      // Permite gerenciar se for Admin, o comprador, ou o vendedor do pedido
      allow update, delete: if isSignedIn() && (isAdmin() || isOwner(existing().buyerUid) || isOwner(existing().shopOwnerUid));
    }

    // --- Chat de Mensagens (/chatMessages) ---
    // Comunicação instantânea entre feirantes e seus clientes.
    match /chatMessages/{messageId} {
      // Permite ler se o remetente ou destinatário for o próprio usuário, ou se for administrador
      allow read: if isSignedIn() && (
        isOwner(existing().senderUid) || isOwner(existing().receiverUid) ||
        isOwner(existing().senderId) || isOwner(existing().receiverId) ||
        isAdmin()
      );
      allow create: if isSignedIn(); // Qualquer usuário logado pode enviar mensagens
    }

    // --- Formulário de Contato (/contactMessages) ---
    // Mensagens de fale conosco enviadas pelo portal público.
    match /contactMessages/{id} {
      allow read, delete: if isAdmin(); // Apenas administradores oficiais leem as mensagens recebidas
      allow create: if true; // Qualquer pessoa (mesmo sem cadastro) pode enviar uma mensagem de suporte/contato
    }

    // --- Mensagens Rápidas / Templates (/quickMessages) ---
    // Modelos de mensagens pré-programadas para dar agilidade.
    match /quickMessages/{id} {
      allow read: if isSignedIn(); // Qualquer logado pode usar respostas automáticas
      allow write: if isAdmin(); // Apenas admins definem novos modelos
    }

    // --- Vagas de Trabalho na Feira Cooperativa (/jobOpenings) ---
    // Oportunidades disponíveis para contratação de ajudantes/feirantes.
    match /jobOpenings/{id} {
      allow read: if true; // Oportunidades de emprego são visíveis a qualquer profissional interessado
      allow write: if isAdmin(); // Apenas administradores do portal publicam novas vagas
    }

    // --- Candidaturas a Vagas (/jobApplications) ---
    // Currículos e dados enviados para se candidatar às vagas.
    match /jobApplications/{id} {
      allow read: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid); // Admins visualizam candidaturas ou o próprio candidato revisa sua inscrição
      allow create: if isSignedIn(); // Profissional logado pode enviar candidatura
      allow update: if isAdmin(); // Somente administradores atualizam status da candidatura (como "Aprovado" ou "Recusado")
    }

    // --- Controle de Administradores (/admins) ---
    // Listagem auxiliar contendo UIDs de administradores de suporte.
    match /admins/{adminId} {
      allow read: if isSignedIn(); // Logados podem ler para fins de verificação de permissão no frontend
      allow write: if isSuperAdmin(); // Apenas o Super Admin principal tem privilégios para promover ou rebaixar admins
    }

    // --- Validador de Status (/healthcheck) ---
    // Usado pela infraestrutura para validar o canal WebSockets do Firestore.
    match /healthcheck/{id} {
      allow read, write: if true;
    }

    // --- Log de Usuários Deletados (/deletedUsers) ---
    // Logs de auditoria para fins legais contendo contas desativadas.
    match /deletedUsers/{id} {
      allow read, write: if isAdmin(); // Acesso altamente restrito por normas de proteção de dados (LGPD)
    }

    // ==========================================
    // 3. CONSULTAS DE COLEÇÕES AGRUPADAS (COLLECTION GROUPS)
    // Necessárias para realizar queries em sub-coleções de forma global.
    // ==========================================
    
    // Permite consultas globais por produtos em todas as quitandas simultaneamente
    match /{path=**}/products/{productId} {
      allow read: if true;
    }

    // Permite extratos globais de vendas consolidadas
    match /{path=**}/sales/{saleId} {
      allow read: if isAdmin() || (isSignedIn() && (isOwner(resource.data.shopOwnerUid) || isOwner(resource.data.buyerUid)));
    }

    // Permite extratos consolidados de disbursements
    match /{path=**}/disbursements/{disId} {
      allow read: if isAdmin() || (isSignedIn() && isOwner(resource.data.shopOwnerUid));
    }
  }
}
